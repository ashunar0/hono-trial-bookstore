{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookstore",
  "main": "src/main.ts",
  "compatibility_date": "2026-09-01",
  // Better Auth's baseURL. Not deployed, so only the local one
  "vars": { "BETTER_AUTH_URL": "http://localhost:8787" },
  // Writes src/routes.gen.ts before wrangler dev and wrangler deploy, and again while dev runs when src/routes changes
  "build": { "command": "pnpm hnk prepare", "watch_dir": "src/routes" },
  // One schedule for both crons in src/crons. sweep-orders: expired payments, orders left placing, cancels and returns that stopped halfway, points to earn. send-stock-alerts: stock alert mails
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstore",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
}
